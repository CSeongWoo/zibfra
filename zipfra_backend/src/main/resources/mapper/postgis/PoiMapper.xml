<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.zipfra.mapper.postgis.PoiMapper">

    <!--
      AGENTS.md §4: 미터 반경은 ::geography 캐스팅 필수.
      gist_poi_geog 함수형 인덱스를 타려면 표현식이 인덱스 정의와 '문자 그대로' 동일해야 한다.
      typmod(::geography(Point,4326)) 를 붙이면 인덱스 스킵(풀스캔) → 절대 금지.
      distance_meters → distanceMeters 는 map-underscore-to-camel-case 로 매핑.
    -->
    <select id="findWithin" resultType="com.example.zipfra.dto.location.PoiDistanceDTO">
        SELECT category,
               ST_Distance(
                   geom::geography,
                   ST_SetSRID(ST_MakePoint(#{lon}, #{lat}), 4326)::geography
               ) AS distance_meters
        FROM poi
        WHERE ST_DWithin(
                  geom::geography,
                  ST_SetSRID(ST_MakePoint(#{lon}, #{lat}), 4326)::geography,
                  #{radiusMeters}
              )
    </select>

</mapper>
