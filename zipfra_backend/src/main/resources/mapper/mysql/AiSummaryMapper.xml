<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  mysql_ai_summaries 캐싱 테이블 SQL 매퍼 (AGENTS.md §6.3·§8.3).
  primarySqlSessionFactory 가 classpath:mapper/mysql/**/*.xml 를 스캔.

  테이블 DDL (참고):
  CREATE TABLE mysql_ai_summaries (
      id               BIGINT       NOT NULL AUTO_INCREMENT,
      summary_type     VARCHAR(20)  NOT NULL,           -- PROPERTY | REVIEW
      target_id        BIGINT       NOT NULL,
      target_type      VARCHAR(20)  NULL,               -- NULL(PROPERTY) | BUILDING | AREA
      summary_available TINYINT(1)  NOT NULL DEFAULT 0,
      summary_json     JSON         NULL,               -- 전체 응답 페이로드 (summaryAvailable=false 시 NULL)
      created_at       DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
      expires_at       DATETIME     NOT NULL,           -- created_at + TTL
      PRIMARY KEY (id),
      UNIQUE KEY uq_summary (summary_type, target_id, target_type)
  ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
-->
<mapper namespace="com.example.zipfra.mapper.mysql.AiSummaryMapper">

    <!-- ─── resultMap ──────────────────────────────────────────────────── -->
    <resultMap id="AiSummaryResultMap" type="com.example.zipfra.domain.AiSummary">
        <id     property="id"               column="id"/>
        <result property="summaryType"      column="summary_type"/>
        <result property="targetId"         column="target_id"/>
        <result property="targetType"       column="target_type"/>
        <result property="summaryAvailable" column="summary_available"/>
        <result property="summaryJson"      column="summary_json"/>
        <result property="createdAt"        column="created_at"/>
        <result property="expiresAt"        column="expires_at"/>
    </resultMap>

    <!--
      유효한 캐시 단건 조회.
      - expires_at > NOW() 조건으로 만료 캐시 자동 필터
      - target_type IS NULL 허용: PROPERTY 타입은 target_type이 NULL
      - ORDER BY created_at DESC: 동일 키의 최신 캐시 우선
      AGENTS.md §6.3 캐시 룩업 의사코드 구현.
    -->
    <select id="findValid" resultMap="AiSummaryResultMap">
        SELECT id, summary_type, target_id, target_type,
               summary_available, summary_json, created_at, expires_at
        FROM mysql_ai_summaries
        WHERE summary_type = #{summaryType}
          AND target_id    = #{targetId}
          AND (
              <choose>
                  <when test="targetType == null">
                      target_type IS NULL
                  </when>
                  <otherwise>
                      target_type = #{targetType}
                  </otherwise>
              </choose>
          )
          AND expires_at > NOW()
          AND summary_available = 1
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <!--
      캐시 Upsert.
      - UNIQUE KEY (summary_type, target_id, target_type) 충돌 시 UPDATE
      - expires_at = DATE_ADD(NOW(), INTERVAL #{ttlHours} HOUR)
      - GIGO 방지: AiSummaryService가 summaryAvailable=true 인 응답만 이 메서드를 호출함
      AGENTS.md §6.3 upsertCache 의사코드 구현.
    -->
    <insert id="upsert">
        INSERT INTO mysql_ai_summaries
            (summary_type, target_id, target_type, summary_available, summary_json, created_at, expires_at)
        VALUES
            (#{summaryType}, #{targetId}, #{targetType}, 1, #{summaryJson},
             NOW(), DATE_ADD(NOW(), INTERVAL #{ttlHours} HOUR))
        ON DUPLICATE KEY UPDATE
            summary_available = 1,
            summary_json      = VALUES(summary_json),
            created_at        = NOW(),
            expires_at        = DATE_ADD(NOW(), INTERVAL #{ttlHours} HOUR)
    </insert>

    <!--
      캐시 즉시 만료.
      - REV-02(리뷰 작성) / REV-04(리뷰 삭제) 이벤트 후 호출
      - expires_at = NOW(): 다음 요청 시 캐시 MISS → LLM 재호출 트리거
      - summary_type = 'REVIEW': PROPERTY 캐시는 리뷰 이벤트에 영향받지 않음
      AGENTS.md §6.8 리뷰 이벤트 무효화 규칙 구현.
    -->
    <update id="invalidateByTargetId">
        UPDATE mysql_ai_summaries
        SET expires_at = NOW()
        WHERE target_id   = #{targetId}
          AND summary_type = 'REVIEW'
    </update>

</mapper>
