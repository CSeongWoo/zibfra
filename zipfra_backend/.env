# =================================================================
# Zipfra Backend Environment Variables
# =================================================================

# 1. MySQL (PrimaryDataSource) 설정
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=zipfra_primary
MYSQL_USER=root
MYSQL_PASSWORD=1234

# 2. PostGIS (SpatialDataSource) 설정
PG_HOST=localhost
PG_PORT=5432
PG_DB=zipfra_spatial
PG_USER=root
PG_PASSWORD=1234

# 3. JWT 시크릿
JWT_SECRET_KEY=이것은매우길고긴집프라의아름다운토큰시크릿키입니다모두보안을지킵시다

# 4. Redis (§10 — RT/AT Blacklist 토큰 상태 관리)
REDIS_HOST=localhost
REDIS_PORT=6379